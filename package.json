{
  "name": "a_m_theme",
  "version": "1.0.0",
  "private": "true",
  "engines": {
    "node": "20.20.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && npm run copy-images-dir",
    "dev-debug": "DEBUG='vite:*' npm run dev",
    "copy-images-dir": "cp -r resources/images/ dist/",
    "lint": "npx eslint resources",
    "lint-fix": "npx eslint resources --fix"
  },
  "keywords": [
    "wordpress",
    "vite",
    "vuejs",
    "tailwindcss",
    "roots"
  ],
  "author": "Ingo Gutwin",
  "license": "MIT",
  "description": "Classic wordpress theme with vuejs + vite + tailwindcss.",
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@faker-js/faker": "10.2.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.13.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "10.4.23",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "jiti": "2.6.1",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.2.0",
    "vitest": "4.0.17",
    "vue": "^3.5.13",
    "vue-tsc": "3.2.1",
    "zod": "4.3.5"
  },
  "dependencies": {
    "swiper": "12.1.2"
  }
}
